# Local PostgreSQL configuration for Docker Compose and future API Gateway access.
# Copy this file to .env and replace the password before starting containers.

POSTGRES_DB=nestflux
POSTGRES_USER=nestflux
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nestflux:replace_with_a_unique_local_password@localhost:5432/nestflux?schema=public

# Local RabbitMQ configuration for Docker Compose and future services.
RABBITMQ_DEFAULT_USER=nestflux
RABBITMQ_DEFAULT_PASS=replace_with_a_different_unique_local_password
RABBITMQ_DEFAULT_VHOST=nestflux
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://nestflux:replace_with_a_different_unique_local_password@localhost:5672/nestflux
RABBITMQ_ASSET_QUEUE=asset-processing

# Automatic transactional outbox dispatch from the API Gateway.
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_CLAIM_TTL_MS=60000
